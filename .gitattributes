# Normalise line endings in the repository; Windows checkouts still get CRLF where git is set up that way.
* text=auto

# Windows scripts must keep CRLF, shell scripts must keep LF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.sh  text eol=lf
gradlew text eol=lf

# Binary files
*.png  binary
*.jpg  binary
*.jpeg binary
*.ttf  binary
*.pdf  binary
*.jar  binary
